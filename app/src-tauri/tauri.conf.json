{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TargetX",
  "version": "0.4.0",
  "identifier": "cv.codedrichy.targetx",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TargetX",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' https://raw.githubusercontent.com https://targetx-ask.rishipraseeth.workers.dev"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/CodedRichy/TargetX/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBMjFDNDQzNjM3OTJCMzYKUldRMkszbGpROFFocW9kOHdVSjNmUzZqaWRFZmxpcHFYZEkrZEUxcUUyNGJockxwL0FpcE9RcU0K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi", "deb", "appimage", "app", "dmg"],
    "publisher": "Rishi Praseeth Krishnan",
    "copyright": "Copyright (c) 2026 Rishi Praseeth Krishnan. Licensed under BUSL-1.1; see LICENSE.",
    "licenseFile": "../../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "KTU 2024 academic tracker",
    "longDescription": "Attendance, internal marks and target grades for the KTU 2024 scheme. Works out what you still need in each exam, how many classes you can miss, and which subject is cheapest to push toward your CGPA goal.",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
